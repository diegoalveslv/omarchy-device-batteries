#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
shell_root=${OMARCHY_SHELL_ROOT:-/usr/share/omarchy/shell}

node --test "$repo_root/test/DeviceModel.test.cjs"
omarchy plugin validate "$repo_root"

if command -v qmllint >/dev/null 2>&1; then
  qmllint_bin=$(command -v qmllint)
elif [[ -x /usr/lib/qt6/bin/qmllint ]]; then
  qmllint_bin=/usr/lib/qt6/bin/qmllint
else
  echo "qmllint is unavailable; skipped QML linting." >&2
  exit 0
fi

# Omarchy's qs.* QML modules live directly under the shell source directory,
# while standalone qmllint expects their URI-shaped path. Create that mapping
# only for linting; it never touches the plugin source or user configuration.
imports_dir=$(mktemp -d "${TMPDIR:-/tmp}/omarchy-device-batteries-qml.XXXXXX")
trap 'rm -rf "$imports_dir"' EXIT
mkdir -p "$imports_dir/qs"
ln -s "$shell_root/Commons" "$imports_dir/qs/Commons"
ln -s "$shell_root/Ui" "$imports_dir/qs/Ui"
"$qmllint_bin" -I "$imports_dir" "$repo_root/DeviceBatteries.qml"
